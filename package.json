{
  "name": "spirit-clash",
  "version": "1.0.0",
  "description": "Procedural fight cinematics (three.js) rendered in headless Chromium with synthesized audio",
  "scripts": {
    "events": "node tools/render.mjs --times 0 --out frames/_tmp --w 320 --h 136 --info audio/events.json",
    "audio": "python3 audio/soundtrack.py",
    "frames": "node tools/render.mjs --frames 0-449 --out frames --workers 2",
    "encode": "bash tools/encode.sh",
    "build": "npm run events && npm run audio && npm run frames && npm run encode",
    "events:30": "node tools/render.mjs --page aurora/index.html --times 0 --out frames30/_tmp --w 320 --h 180 --info aurora/events.json",
    "audio:30": "python3 aurora/soundtrack.py",
    "frames:30": "node tools/render.mjs --page aurora/index.html --frames 0-719 --fps 24 --h 1080 --out frames30 --workers 3",
    "encode:30": "bash tools/encode30.sh",
    "build:30": "npm run events:30 && npm run audio:30 && npm run frames:30 && npm run encode:30"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kts4u1/Movie.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kts4u1/Movie/issues"
  },
  "homepage": "https://github.com/kts4u1/Movie#readme",
  "dependencies": {
    "three": "^0.187.0"
  },
  "type": "commonjs"
}
